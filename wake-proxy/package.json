  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0",
    "http-proxy": "^1.18.1"
  },
  "overrides": {
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=3.0.0 <5.0.12": "5.0.12"
  }
}
